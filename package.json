{
  "name": "calendar-app-multi-user",
  "version": "1.0.0",
  "private": true,
  "description": "Class Calendar Planner — team cloud sync",
  "scripts": {
    "start": "node server/index.js",
    "sync-from-main": "node scripts/sync-from-main.mjs",
    "build": "node scripts/build-assets.mjs",
    "build:help-content": "node scripts/export-help-content.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply calendar-team --remote"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.94.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.21.2"
  }
}
