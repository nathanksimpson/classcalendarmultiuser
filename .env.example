PORT=8080
PUBLIC_URL=http://localhost:8080

# Local dev without Kakao (NOT for production):
ALLOW_OPEN_ACCESS=1

# Kakao Developers → REST API key + redirect URI = {PUBLIC_URL}/api/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Optional — only after enabling matching items in Kakao > 카카오 로그인 > 동의항목 (else KOE205):
# KAKAO_OAUTH_SCOPES=account_email profile_nickname
# KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# First admin: POST /api/admin/bootstrap with this secret (see admin.html)
BOOTSTRAP_ADMIN_SECRET=change-me-before-first-run

# Optional: separate secret for Kakao OAuth state signing (defaults to BOOTSTRAP_ADMIN_SECRET)
# OAUTH_STATE_SECRET=

# Production HTTPS only:
# COOKIE_SECURE=1
