PORT=8080
PUBLIC_URL=http://localhost:8080

# Local dev without Kakao (NOT for production):
ALLOW_OPEN_ACCESS=1

# Kakao Developers → REST API key + redirect URI = {PUBLIC_URL}/api/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Optional — only after enabling matching items in Kakao > 카카오 로그인 > 동의항목 (else KOE205):
# KAKAO_OAUTH_SCOPES=account_email profile_nickname
# KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# First admin: POST /api/admin/bootstrap with this secret (see admin.html)
BOOTSTRAP_ADMIN_SECRET=change-me-before-first-run

# Optional: separate secret for Kakao OAuth state signing (defaults to BOOTSTRAP_ADMIN_SECRET)
# OAUTH_STATE_SECRET=

# Application-level blob encryption for calendar JSON in D1/SQLite (32-byte key, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: wrangler secret put DATA_ENCRYPTION_MASTER_KEY
# DATA_ENCRYPTION_MASTER_KEY=
# Require key for writes (fail if unset): DATA_ENCRYPTION_REQUIRED=1

# Production HTTPS only:
# COOKIE_SECURE=1

# Optional local-only: proxy /api/translate to production (Workers AI does not run on npm start).
# Translation is a Cloudflare Workers AI feature — test after `npm run deploy` on https://classmanager.live
# TRANSLATE_PROXY_URL=https://classmanager.live/api/translate
