PORT=8080
PUBLIC_URL=http://localhost:8080

# Local dev without Kakao (NOT for production):
ALLOW_OPEN_ACCESS=1

# Kakao Developers → REST API key + redirect URI = {PUBLIC_URL}/api/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# First admin: POST /api/admin/bootstrap with this secret (see admin.html)
BOOTSTRAP_ADMIN_SECRET=change-me-before-first-run

# Production HTTPS only:
# COOKIE_SECURE=1
